{
  "manifest_version": 3,
  "name": "AI Chatter Browser Extension",
  "description": "AI Chatter Branch 4.0.17 Qwen + DeepSeek provider workers",
  "version": "4.0.17",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI Chatter 4",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
